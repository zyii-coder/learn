# 依赖与构建产物
node_modules/
dist/
build/
__pycache__/
*.py[cod]
.venv/
venv/

# 环境与密钥
.env
.env.*
!.env.example

# 编辑器与系统
# .vscode 里的工程配置要跟着仓库走（例如 tasklist-java/.vscode 的 F5 调试配置）。
# 必须写 **/.vscode/* —— 写成 .vscode/* 会锚定到仓库根，匹配不到子目录；
# 写成 .vscode/ 又会把整个目录排除，后面的 ! 规则救不回来。
**/.vscode/*
!**/.vscode/settings.json
!**/.vscode/launch.json
!**/.vscode/tasks.json
!**/.vscode/extensions.json
.idea/
.DS_Store
Thumbs.db

# 日志与临时文件
*.log
*.tmp

# 本地工作区数据（不纳入版本控制）
.workbuddy/
.node_modules/